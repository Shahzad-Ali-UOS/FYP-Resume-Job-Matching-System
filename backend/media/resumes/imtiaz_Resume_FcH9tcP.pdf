òôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôô