òôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôô