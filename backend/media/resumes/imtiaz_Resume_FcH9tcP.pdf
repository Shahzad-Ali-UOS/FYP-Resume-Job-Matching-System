òôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôò