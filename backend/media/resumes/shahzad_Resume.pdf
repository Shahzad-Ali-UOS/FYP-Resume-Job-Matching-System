òôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôò