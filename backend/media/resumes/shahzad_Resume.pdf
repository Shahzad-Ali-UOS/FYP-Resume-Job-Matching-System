ôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòÿÿÿôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôòôôò